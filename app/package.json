{
  "name": "sylva-landing",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Crypto portfolio landing page rebuilt from a motion reference, with a procedurally composited hero.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "typecheck": "tsc -b --noEmit",
    "preview": "vite preview",
    "assets": "python scripts/build_assets.py",
    "shots": "node scripts/shoot.mjs shots",
    "deploy": "node scripts/deploy-pages.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/inter-tight": "^5.3.0",
    "gsap": "^3.15.0",
    "lenis": "^1.3.25",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "playwright": "^1.62.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  }
}
